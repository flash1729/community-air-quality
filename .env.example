# Copy to .env and fill in. Never commit the real .env file.

# Required for live monitoring-station data. Leave blank to use the bundled sample dataset.
# Create a key at https://explore.openaq.org/register
OPENAQ_API_KEY=

# Optional overrides
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
DATABASE_URL=sqlite:///./data/airquality.db
CACHE_TTL_MINUTES=30
STALE_AFTER_MINUTES=180
CORS_ORIGINS=http://localhost:3000

# Used by the Next.js server to reach FastAPI. Docker Compose overrides this.
API_INTERNAL_URL=http://127.0.0.1:8000
